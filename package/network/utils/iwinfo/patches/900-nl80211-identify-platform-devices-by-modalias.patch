Subject: [PATCH] nl80211: identify platform devices by modalias

A phy whose parent is a platform device registered by its driver (no
device tree node), such as the UNISOC UWE5622 SDIO driver's
"unisoc_wifi", has neither PCI/USB IDs nor of_node/compatible, so it is
reported as "Generic MAC80211". When of_node/compatible is absent, fall
back to the device's modalias if it is "platform:<name>" and match it
against the compatible-string entries of devices.txt.

diff --git a/devices.txt b/devices.txt
index 5660a24..7f26b2b 100644
--- a/devices.txt
+++ b/devices.txt
@@ -270,3 +270,4 @@
 "ralink,rt3883-wmac"    0      0  "Ralink" "Rt3883"
 "ralink,rt5350-wmac"    0      0  "Ralink" "Rt5350"
 "ralink,rt7620-wmac"    0      0  "MediaTek" "MT7620"
+"platform:unisoc_wifi"  0      0  "Unisoc" "UWE5622"
diff --git a/iwinfo_nl80211.c b/iwinfo_nl80211.c
index 1dd6a67..04925ce 100644
--- a/iwinfo_nl80211.c
+++ b/iwinfo_nl80211.c
@@ -3715,10 +3715,22 @@ static int nl80211_hardware_id_from_fdt(struct iwinfo_hardware_id *id, const cha
 	snprintf(path, sizeof(path), "/sys/class/%s/%s/device/of_node/compatible",
 	         phy ? "ieee80211" : "net", phy ? phy : ifname);
 
-	if (nl80211_readstr(path, id->compatible, sizeof(id->compatible)) <= 0)
-		return -1;
+	if (nl80211_readstr(path, id->compatible, sizeof(id->compatible)) > 0)
+		return 0;
 
-	return 0;
+	/*
+	 * Platform devices registered by their driver have no of_node; match
+	 * them by modalias ("platform:<name>") against the same table.
+	 */
+	snprintf(path, sizeof(path), "/sys/class/%s/%s/device/modalias",
+	         phy ? "ieee80211" : "net", phy ? phy : ifname);
+
+	if (nl80211_readstr(path, id->compatible, sizeof(id->compatible)) > 0 &&
+	    !strncmp(id->compatible, "platform:", 9))
+		return 0;
+
+	id->compatible[0] = 0;
+	return -1;
 }
 
 
