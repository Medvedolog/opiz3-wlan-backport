#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		sleep 15
		/sbin/modprobe uwe5622_bsp_sdio || exit 1
		sleep 5
		/sbin/modprobe sprdwl_ng disable_powersave=1 || exit 1

		i=0
		while [ ! -e /sys/class/ieee80211/phy0 ] && [ "$i" -lt 30 ]; do
			sleep 1
			i=$((i + 1))
		done
		[ -e /sys/class/ieee80211/phy0 ] || exit 1

		# Configure the factory AP exactly once, after phy0 exists.
		# Subsequent boots preserve all operator changes.
		if [ ! -e /etc/opiz3-ap-initialized ]; then
			[ -s /etc/config/wireless ] || /sbin/wifi config

			for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface.*/\1/p"); do
				uci -q delete "wireless.$s"
			done

			uci -q batch <<-EOF
				set wireless.radio0.disabled=0
				set wireless.radio0.band=2g
				set wireless.radio0.channel=7
				set wireless.radio0.htmode=HT20
				set wireless.opiz3_ap=wifi-iface
				set wireless.opiz3_ap.device=radio0
				set wireless.opiz3_ap.network=lan
				set wireless.opiz3_ap.mode=ap
				set wireless.opiz3_ap.ssid=OPIZ3_AP
				set wireless.opiz3_ap.encryption=psk2
				set wireless.opiz3_ap.cipher=ccmp
				set wireless.opiz3_ap.key=12345678
				set wireless.opiz3_ap.ieee80211w=0
			EOF
			uci commit wireless

			# Make Footstrap the LuCI default on a clean image.
			uci -q set luci.main.mediaurlbase=/luci-static/footstrap
			uci -q commit luci

			touch /etc/opiz3-ap-initialized
		fi

		/sbin/wifi up radio0
	'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
