#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	# KEDUA modul ditunda, bukan hanya sprdwl_ng.
	#
	# Versi asli (dari PR ImmortalWrt untuk Orange Pi 3 LTS) sengaja
	# membiarkan uwe5622_bsp_sdio di-autoload lewat /etc/modules.d/30-uwe5622.
	# Autoload itu dijalankan kmodloader pada S10boot -- jauh sebelum S20network.
	# Di Orange Pi Zero 3, probe SDIO-nya menggantung di sana dan boot berhenti
	# total sebelum jaringan pernah naik: board menyala, link ethernet hidup,
	# tapi nol frame terkirim.
	#
	# Dimuat di sini, setelah netifd selesai, kegagalan driver paling buruk
	# hanya berarti Wi-Fi mati -- bukan seluruh gateway tidak bisa dijangkau.
	procd_open_instance
	procd_set_param command /bin/sh -c \
		'sleep 15; \
		 /sbin/modprobe uwe5622_bsp_sdio || exit 1; \
		 sleep 5; \
		 /sbin/modprobe sprdwl_ng || exit 1; \
		 i=0; while [ ! -e /sys/class/ieee80211/phy0 ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done; \
		 [ -e /sys/class/ieee80211/phy0 ] || exit 1; \
		 /sbin/wifi up radio0'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
