#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	# BOTH modules are deferred, not only sprdwl_ng.
	#
	# The original (an ImmortalWrt PR for the Orange Pi 3 LTS) let
	# uwe5622_bsp_sdio autoload from /etc/modules.d/30-uwe5622, which
	# kmodloader runs at S10boot, long before S20network. On the Orange Pi
	# Zero 3 its SDIO probe hung there and the boot stopped before the
	# network ever came up: board on, Ethernet link up, no frame sent.
	#
	# Loaded here, after netifd, a driver failure at worst means no Wi-Fi,
	# not an unreachable gateway.
	#
	# Firmware power save is off on purpose: in sleep the UWE5622 can drop
	# broadcast/multicast, and for an AP/router stable ARP, IPv6 ND and mDNS
	# matter more than saving a few tenths of a watt.
	#
	# The radio is found by its device path, not as phy0/radio0
	# (/lib/uwe5622.sh): a USB adapter present at boot registers first.
	#
	# insmod, not modprobe: ubox modprobe takes module names only and drops
	# any "param=value" argument (parameters come from /etc/modules.conf),
	# so "modprobe sprdwl_ng disable_powersave=1" never set the parameter.
	# insmod passes its arguments through. Dependencies (cfg80211,
	# uwe5622_bsp_sdio) are already loaded at this point. Extra driver
	# parameters, e.g. max_bw_5g=80, go in /etc/uwe5622.options.
	#
	# On the first boot the radio appears long after LuCI and the hotplug
	# "wifi config" may or may not have run yet: create the config here if
	# it is missing; on the first boot of a flashed image set it up as a
	# 5 GHz WPA2 AP with a default password (uwe5622-default-ap), make
	# netifd load it (or "wifi up" finds no radio0), so
	# that the htmode clamp sees it, and drop LuCI's menu cache,
	# built while there was no wireless config, so "Wireless" shows up.
	# The network is reloaded only when the wireless config changed here:
	# a reload at this point (~35 s) restarts the LTE modem interface while
	# ModemManager is still probing it, and it stays down.
	/usr/sbin/uwe5622-iwinfo-name
	/usr/sbin/uwe5622-hostap-macaddr

	procd_open_instance
	procd_set_param command /bin/sh -c \
		'. /lib/uwe5622.sh; \
		 sleep 15; \
		 /sbin/modprobe uwe5622_bsp_sdio || exit 1; \
		 sleep 5; \
		 [ -d /sys/module/sprdwl_ng ] || uwe_load_wifi || exit 1; \
		 uwe_wait_phy 30 >/dev/null || exit 1; \
		 c=0; \
		 [ -n "$(uwe_radios)" ] || { /sbin/wifi config; c=1; }; \
		 /usr/sbin/uwe5622-default-ap && c=1; \
		 /usr/sbin/uwe5622-clamp-htmode; [ $? = 2 ] && c=1; \
		 [ $c = 0 ] || { ubus call network reload; sleep 2; }; \
		 rm -f /tmp/luci-indexcache*; \
		 uwe_wifi up'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
