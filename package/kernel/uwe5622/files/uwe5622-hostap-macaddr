#!/bin/sh
# Never reuse an interface of the UWE5622 radio in wifi-scripts.
#
# For a fullmac phy (no monitor mode, like this driver) wdev_create() in
# /usr/share/hostap/common.uc does not create the interface: it takes any
# interface of the phy whose operstate is down, renames it and changes its
# type with NL80211_CMD_SET_INTERFACE. On this radio that
# - drops the MAC computed for the interface (SET_INTERFACE has none), so an
#   AP and a station both keep the chip MAC and AP clients cannot join, and
# - races: wpa_supplicant took the interface hostapd was setting up for the
#   AP ("phy0-sta0: renamed from phy0-ap0") and the AP did not start
# (repeater, TEST-PLAN S5, 2026-10-07). This driver deletes and creates
# interfaces fine, so for this phy wdev_create() always does
# NL80211_CMD_NEW_INTERFACE with the MAC; patch 290 applies it.
#
# Runs at every boot (sprdwl-delay), before the radio comes up, so it is
# applied again after wifi-scripts is upgraded. hostapd and wpa_supplicant
# load common.uc when they start: they are restarted when it changes.

changed=0
F=/usr/share/hostap/common.uc
[ -f "$F" ] || F=
[ -n "$F" ] && grep -q 'uwe5622: never reuse' "$F" && F=
if [ -n "$F" ]; then
# an earlier test version of this script
if grep -q 'uwe5622: reused interface MAC' "$F"; then
	awk '/uwe5622: reused interface MAC/ { skip = 3 } skip { skip--; next } { print }' \
		"$F" > "$F.uwe" && cat "$F.uwe" > "$F"
	rm -f "$F.uwe"
fi
if grep -q '^	let reuse_ifname = find_reusable_wdev(phyidx);$' "$F"; then

sed -i '/^	let reuse_ifname = find_reusable_wdev(phyidx);$/a\
	/* uwe5622: never reuse an interface of this radio (MAC, races) */\
	if (index(readfile(`/sys/class/ieee80211/${phy}/device/modalias`) ?? "", "platform:unisoc_wifi") == 0)\
		reuse_ifname = null;' "$F"

logger -t uwe5622 "wifi-scripts: interfaces of the UWE5622 radio are always created anew ($F)"
changed=1
fi
fi

# a test version delayed the station in wpa_supplicant.uc (did not help
# against the repeater hang, TEST-PLAN 2026-10-08): take it out again
W=/usr/share/hostap/wpa_supplicant.uc
if [ -f "$W" ] && grep -q 'uwe5622: station after the AP' "$W"; then
	awk '/uwe5622: drop a station start still waiting/ { skip = 4; next }
	     /uwe5622: station after the AP/ { skip = 11; print "\t\t\t\tstart_pending(name);"; next }
	     skip { skip--; next } { print }' "$W" > "$W.uwe" && cat "$W.uwe" > "$W"
	rm -f "$W.uwe"
	changed=1
fi

[ "$changed" = 1 ] && [ -x /etc/init.d/wpad ] && /etc/init.d/wpad running 2>/dev/null &&
	/etc/init.d/wpad restart
exit 0
