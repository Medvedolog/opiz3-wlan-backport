#!/usr/bin/ucode
// Apply /usr/share/opiz3/luci-nosig.json to the LuCI Wi-Fi views: an AP
// whose driver reports no client RSSI is shown as up, with its client count,
// instead of "No client associated". Runs at every boot (/etc/init.d/opiz3),
// so it is applied again after luci-mod-network or luci-mod-status is
// upgraded. A file is left alone unless every anchor matches exactly once.
'use strict';

import { readfile, writefile } from 'fs';

const t = json(readfile('/usr/share/opiz3/luci-nosig.json') ?? 'null');

for (let f in t?.files ?? []) {
	let s = readfile(f.path);

	if (s == null || index(s, t.marker) >= 0)
		continue;

	let ok = true;

	for (let e in f.edits) {
		let i = index(s, e[0]);

		if (i < 0 || index(substr(s, i + 1), e[0]) >= 0) {
			ok = false;
			break;
		}

		s = substr(s, 0, i) + e[1] + substr(s, i + length(e[0]));
	}

	if (ok)
		writefile(f.path, s);
	else
		system(['logger', '-t', 'opiz3', `LuCI signal patch: ${f.path} does not match, left as is`]);
}
